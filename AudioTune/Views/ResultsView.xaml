<UserControl x:Class="AudioTune.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DebugColumn" Width="310"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="280"/><RowDefinition Height="260"/><RowDefinition Height="190"/></Grid.RowDefinitions>

                <!-- header -->
                <Border Style="{StaticResource CardBorderStyle}" MinHeight="190">
                    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/Headphones/AmironHome.png" Stretch="Uniform" Margin="0,0,18,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Beyerdynamic Amiron Home" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ResultModeText" Text="End-to-end hearing profile" Foreground="#78C9FF" Margin="0,5,0,0"/><TextBlock x:Name="ResultTimestampText" Text="No completed measurement yet" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11"/><TextBlock Text="Results are displayed as relative digital thresholds (dBFS), not clinical dB HL." Foreground="#DAB96A" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border x:Name="DataModeBadge" Background="#5B461D" CornerRadius="7" Padding="10,6"><TextBlock x:Name="DataModeText" Text="Demo visualization" Foreground="#F0D18A" HorizontalAlignment="Center"/></Border><TextBlock Text="Calibration mode" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="End-to-end only" Foreground="{StaticResource AmberBrush}" FontSize="11" HorizontalAlignment="Center"/><Button x:Name="OpenListeningTestButton" Content="A/B Listening Test" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Padding="10,7" Click="OpenListeningTest_Click" IsEnabled="False"/><Button x:Name="OpenFineTuneButton" Content="Start optional Fine Tuning" Style="{StaticResource FlatButtonStyle}" Margin="0,7,0,0" Padding="10,7" Click="OpenFineTune_Click" IsEnabled="False"/><Button x:Name="OpenCenteringButton" Content="Stereo Centering" Style="{StaticResource FlatButtonStyle}" Margin="0,7,0,0" Padding="10,7" Click="OpenCentering_Click" IsEnabled="False"/></StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics -->
                <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,5,0"><StackPanel Margin="12" VerticalAlignment="Center"><TextBlock Text="Measurements" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="MeasurementsMetric" Text="0 / 60" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="3,0"><StackPanel Margin="12" VerticalAlignment="Center"><TextBlock Text="Retest variance" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="needs ≥2 sessions" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="3,0"><StackPanel Margin="12" VerticalAlignment="Center"><TextBlock Text="Preview gain cap" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="±6.0 dB" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="3,0"><StackPanel Margin="12" VerticalAlignment="Center"><TextBlock Text="Correction strength" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="CorrectionStrengthMetric" Text="100%" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="experimental preview" Foreground="{StaticResource AmberBrush}" FontSize="9"/></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Margin="5,0,0,0"><StackPanel Margin="12" VerticalAlignment="Center"><TextBlock Text="Portability" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="PortabilityMetric" Text="Device-bound" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                </Grid>

                <!-- Threshold charts -->
                <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,5,0"><Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="L   Left Ear — Hearing Threshold" FontWeight="SemiBold"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="More sensitive ↑" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right"/><TextBlock x:Name="LeftThresholdValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right"/></StackPanel></Grid><controls:FrequencyChart x:Name="LeftThresholdChart" Grid.Row="1" MinimumY="-3" MaximumY="-90" YUnit="dBFS" /></Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="5,0,0,0"><Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="R   Right Ear — Hearing Threshold" FontWeight="SemiBold"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="More sensitive ↑" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right"/><TextBlock x:Name="RightThresholdValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right"/></StackPanel></Grid><controls:FrequencyChart x:Name="RightThresholdChart" Grid.Row="1" MinimumY="-3" MaximumY="-90" YUnit="dBFS" /></Grid></Border>
                </Grid>

                <!-- Combined chart -->
                <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,5,0"><Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Personal Correction Preview" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/><TextBlock Text="Left" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/><Ellipse Width="7" Height="7" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/><TextBlock Text="Right" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/><CheckBox x:Name="ShowFineTuneCheck" Content="Preview with Fine Tune (display only)" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Checked="ShowFineTuneChanged" Unchecked="ShowFineTuneChanged"/><CheckBox x:Name="ShowRawStereoCheck" Content="Show pre-stereo L/R" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ShowFineTuneChanged" Unchecked="ShowFineTuneChanged"/><CheckBox x:Name="ShowActualDspCheck" Content="Show actual DSP/APO response" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ShowFineTuneChanged" Unchecked="ShowFineTuneChanged"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="CorrectionApplyStateText" Text="Threshold-derived correction" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right"/><TextBlock x:Name="CorrectionValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid><controls:FrequencyChart x:Name="CorrectionChart" Grid.Row="1" MinimumY="-12" MaximumY="12" YUnit="dB" ShowZeroLine="True"/></Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="5,0,0,0"><StackPanel Margin="16,12"><TextBlock Text="Profile Scope" FontWeight="SemiBold"/><Border Background="#102E2A" CornerRadius="8" Padding="12" Margin="0,15,0,0"><StackPanel><TextBlock Text="End-to-end calibration" Foreground="#73D8C7" FontSize="10"/><TextBlock Text="Measures the complete headphone + fit + ear + hearing chain." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#172333" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="Transferability" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Device-bound for now · remeasure when changing headphones." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
                    <Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="Per-Frequency Correction Amount" FontWeight="SemiBold"/><TextBlock Text="Experimental preview only" Foreground="{StaticResource AmberBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><controls:CorrectionBarChart x:Name="CorrectionBars" Grid.Row="1" /></Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Developer drawer -->
        <Border x:Name="DeveloperPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="17,15">
                <TextBlock Text="›_  Debug &amp; Developer Info" FontFamily="Consolas" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Measurement state" Foreground="#69BFFF" FontWeight="SemiBold" Margin="0,20,0,7"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Session" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="DebugSession" Grid.Column="1" Text="none" FontSize="10" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="Measurements" Style="{StaticResource MutedTextStyle}" Margin="0,6"/><TextBlock x:Name="DebugMeasurements" Grid.Row="1" Grid.Column="1" Text="0" FontSize="10" HorizontalAlignment="Right" Margin="0,6"/><TextBlock Grid.Row="2" Text="Value unit" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="dBFS" FontSize="10" HorizontalAlignment="Right"/><TextBlock Grid.Row="3" Text="Clinical calibration" Style="{StaticResource MutedTextStyle}" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="No" Foreground="{StaticResource AmberBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,6"/></Grid>

                <Border Height="1" Background="#26394C" Margin="0,14"/>
                <TextBlock Text="Source Data Information" Foreground="#69BFFF" FontWeight="SemiBold"/>
                <TextBlock Text="Headphone model" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/><TextBlock Text="Beyerdynamic Amiron Home" FontSize="11"/>
                <TextBlock Text="Headphone compensation" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/><TextBlock Text="Disabled" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="Known measurement sources" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/><TextBlock Text="oratory1990 / independent GRAS measurements" TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="Policy" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/><TextBlock Text="No fabricated response points: correction remains disabled until numeric source data is verified." TextWrapping="Wrap" FontSize="11"/>

                <Border Height="1" Background="#26394C" Margin="0,14"/>
                <TextBlock Text="Processing" Foreground="#69BFFF" FontWeight="SemiBold"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Threshold search" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="1" Text="Adaptive bracket" FontSize="10" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="Acceptance" Style="{StaticResource MutedTextStyle}" Margin="0,6"/><TextBlock Grid.Row="1" Grid.Column="1" Text="1 final confirmation" FontSize="10" HorizontalAlignment="Right" Margin="0,6"/><TextBlock Grid.Row="2" Text="Preview strength" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="DebugPreviewStrength" Grid.Row="2" Grid.Column="1" Text="100%" FontSize="10" HorizontalAlignment="Right"/><TextBlock Grid.Row="3" Text="Preview clamp" Style="{StaticResource MutedTextStyle}" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="±6 dB" FontSize="10" HorizontalAlignment="Right" Margin="0,6"/></Grid>

                <Border Background="#211B0F" BorderBrush="#604A22" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,0"><StackPanel><TextBlock Text="⚠ Calibration warning" Foreground="#F0C96B" FontWeight="SemiBold"/><TextBlock Text="Absolute SPL at the eardrum is unknown. Do not interpret these results as a medical audiogram." Foreground="#D8C18D" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
                <Button Content="Refresh Results" Style="{StaticResource FlatButtonStyle}" Margin="0,16,0,0" Click="Refresh_Click" />
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AudioTune.Views.ListeningTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls"
             Focusable="True" PreviewKeyDown="UserControl_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="190" />
                <RowDefinition Height="300" />
                <RowDefinition Height="260" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero / calibration state -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <controls:AccentBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <Grid Margin="22,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/Headphones/AmironHomeCutout.png" Stretch="Uniform" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CALIBRATION LISTENING TEST" Foreground="#7389A1" FontSize="11"/>
                            <TextBlock Text="Original vs. Calibrated" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="Play a familiar, dynamic music track and switch instantly between the untouched signal and your personal calibration without losing playback position."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="19" MaxWidth="720" Margin="0,9,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Border x:Name="CalibrationReadyBadge" Background="#104F43" CornerRadius="6" Padding="9,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="CalibrationReadyText" Text="Calibration ready" Foreground="#71F1C3" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#12273C" CornerRadius="6" Padding="9,4">
                                    <TextBlock Text="25 ms click-free A/B crossfade" Foreground="#8EC9FF" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:AccentBorder>

                <controls:AccentBorder Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Margin="18,15">
                        <TextBlock Text="A/B test principles" FontWeight="SemiBold" FontSize="14"/>
                        <Grid Margin="0,13,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#12375C"><TextBlock Text="↔" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="10,0"><TextBlock Text="Continuous playback" FontWeight="SemiBold"/><TextBlock Text="No restart when switching" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#12375C"><TextBlock Text="−" Foreground="{StaticResource BlueBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="10,0"><TextBlock Text="Common headroom" FontWeight="SemiBold"/><TextBlock Text="Same preamp in A and B" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#12375C"><TextBlock Text="L/R" Foreground="{StaticResource BlueBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="10,0"><TextBlock Text="Per-ear correction" FontWeight="SemiBold"/><TextBlock Text="Left and right remain separate" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </controls:AccentBorder>
            </Grid>

            <!-- Player and A/B switch -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>

                <controls:AccentBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <Grid Margin="20,17">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Music source" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FileNameText" Text="No music loaded" Foreground="#B9C8D8" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Choose Music..." Style="{StaticResource FlatButtonStyle}" Click="ChooseMusic_Click"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#0A121B" BorderBrush="#233A50" BorderThickness="1" CornerRadius="9" Margin="0,16,0,0" Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PlaybackStatusText" Text="Select a music file to begin" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FormatText" Text="MP3, WAV, FLAC, AAC/M4A and other Media Foundation formats" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RestartButton" Content="↺  Restart" Style="{StaticResource FlatButtonStyle}" Margin="0,0,8,0" Click="Restart_Click" IsEnabled="False"/>
                                    <Button x:Name="PlayPauseButton" Content="▶  Play" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="PlayPause_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <ProgressBar x:Name="PlaybackProgress" Height="6" Minimum="0" Maximum="1" Value="0" Background="#172433" Foreground="{StaticResource BlueBrush}" BorderThickness="0"/>
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <TextBlock x:Name="PositionText" Text="00:00" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="DurationText" Text="00:00" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <TextBlock Text="Tip" Foreground="#6EBEFF" FontWeight="SemiBold"/>
                            <TextBlock Text="Use music you know very well with bass, vocals, percussion and quiet/loud passages. Short, rapid comparisons are usually more revealing than listening for several minutes before switching."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" LineHeight="17" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </controls:AccentBorder>

                <controls:AccentBorder Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,0">
                    <Grid Margin="20,17">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Instant A/B switch" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="The track keeps playing at exactly the same position." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="OriginalButton" Grid.Column="0" Style="{StaticResource AbModeButtonStyle}" Tag="Selected" Margin="0,0,6,0" Click="Original_Click">
                                <StackPanel><TextBlock Text="A" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="ORIGINAL" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock Text="Uncorrected" FontSize="10" Foreground="#94A8BD" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="CalibratedButton" Grid.Column="1" Style="{StaticResource AbModeButtonStyle}" Margin="6,0,0,0" Click="Calibrated_Click" IsEnabled="False">
                                <StackPanel><TextBlock Text="B" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="CALIBRATED" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock Text="Personal profile" FontSize="10" Foreground="#94A8BD" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" Background="#0A121B" CornerRadius="8" Padding="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Current" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="CurrentModeText" Text="Original" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Headroom" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="HeadroomText" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Shortcuts" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="O / C / Space" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:AccentBorder>
            </Grid>

            <!-- Correction preview -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <controls:AccentBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Left ear correction preview" FontWeight="SemiBold"/><TextBlock Text="  B also uses saved Fine Tune" Foreground="{StaticResource AmberBrush}" FontSize="10" VerticalAlignment="Center"/><CheckBox x:Name="ShowFineTuneCheck" Content="Preview with Fine Tune (display only)" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ShowFineTuneChanged" Unchecked="ShowFineTuneChanged"/></StackPanel><TextBlock x:Name="LeftCorrectionValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <controls:FrequencyChart x:Name="LeftCorrectionChart" Grid.Row="1" MinimumY="-12" MaximumY="12" YUnit="dB" ShowZeroLine="True"/>
                    </Grid>
                </controls:AccentBorder>
                <controls:AccentBorder Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,0">
                    <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Right ear correction preview" FontWeight="SemiBold"/><TextBlock Text="  B also uses saved Fine Tune" Foreground="{StaticResource AmberBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="RightCorrectionValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <controls:FrequencyChart x:Name="RightCorrectionChart" Grid.Row="1" MinimumY="-12" MaximumY="12" YUnit="dB" ShowZeroLine="True"/>
                    </Grid>
                </controls:AccentBorder>
            </Grid>

            <!-- Debug/status -->
            <controls:AccentBorder x:Name="DebugPanel" Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,4" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="A/B Debug" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Text="Live playback pipeline" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="File format" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="DebugFormatText" Text="—" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Selected output" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="DebugOutputText" Text="—" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="DSP state" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="DebugDspText" Text="Bypass" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Grid>
            </controls:AccentBorder>
        </Grid>
    </ScrollViewer>
</UserControl>

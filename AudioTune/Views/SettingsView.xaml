<UserControl x:Class="AudioTune.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Audio, measurement and development preferences" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>

            <controls:AccentBorder Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Development &amp; Debug" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Debug UI can be completely hidden for a cleaner normal-use interface." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,16" />
                    <CheckBox x:Name="DebugEnabledCheck" Content="Enable debug/developer areas" Style="{StaticResource SwitchStyle}" Margin="0,8" Checked="SettingChanged" Unchecked="SettingChanged" />
                    <CheckBox x:Name="DebugExpandedCheck" Content="Dashboard debug panel expanded by default" Style="{StaticResource SwitchStyle}" Margin="0,12,0,0" Checked="SettingChanged" Unchecked="SettingChanged" />
                </StackPanel>
            </controls:AccentBorder>

            <controls:AccentBorder Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Audio Engine" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="The hearing test uses 48 kHz, 32-bit float stereo and plays only into the selected ear channel." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" />
                    <Border Background="#0C253A" BorderBrush="#174D73" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                        <TextBlock Text="AudioTune application reference volume: 50% (fixed). Only AudioTune's Windows mixer session is set; the device/master volume and all other applications are left untouched." TextWrapping="Wrap" Foreground="#9FD9FF" FontSize="11" />
                    </Border>
                    <CheckBox x:Name="RawModeCheck" Content="Try WASAPI raw mode (bypass supported Windows audio enhancements)" Style="{StaticResource SwitchStyle}" Margin="0,8" Checked="SettingChanged" Unchecked="SettingChanged" />
                    <TextBlock Text="Raw mode is not supported by every endpoint. If initialization fails, disable this option." Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="48,2,0,12" />
                    <Grid Width="430" HorizontalAlignment="Left" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="Requested WASAPI latency" VerticalAlignment="Center"/><Slider x:Name="LatencySlider" Grid.Column="1" Minimum="20" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="LatencySlider_ValueChanged"/><TextBlock x:Name="LatencyText" Grid.Column="2" Text="50 ms" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Grid>
                </StackPanel>
            </controls:AccentBorder>

            <controls:AccentBorder Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="DSP Preamp / Headroom" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Control the negative preamp applied before the personal EQ. Less negative preamp makes the result louder, but can exceed digital full scale when several positive filters overlap." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                    <CheckBox x:Name="AutomaticPreampCheck" Content="Use automatically calculated safe preamp (recommended)" Style="{StaticResource SwitchStyle}" Margin="0,4,0,10" Checked="PreampSettingChanged" Unchecked="PreampSettingChanged"/>

                    <Grid Width="540" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Manual preamp" VerticalAlignment="Center"/>
                        <Slider x:Name="ManualPreampSlider" Grid.Column="1" Minimum="-12" Maximum="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="ManualPreampSlider_ValueChanged"/>
                        <TextBlock x:Name="ManualPreampText" Grid.Column="2" Text="-6.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="0 dB means no headroom attenuation. Moving the slider toward 0 dB can clip if the correction has larger positive composite gain." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="190,4,0,10" TextWrapping="Wrap"/>

                    <CheckBox x:Name="LimitBoostsCheck" Content="If the selected preamp is insufficient, limit positive EQ boosts to the available headroom" Style="{StaticResource SwitchStyle}" Margin="0,7,0,0" Checked="PreampSettingChanged" Unchecked="PreampSettingChanged"/>
                    <TextBlock Text="When enabled, AudioTune preserves cuts but scales positive filter gains until the complete filter cascade fits inside the selected preamp headroom." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="48,3,0,0" TextWrapping="Wrap"/>

                    <Border x:Name="PreampWarningBorder" Background="#211B0F" BorderBrush="#5D4720" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                        <TextBlock x:Name="PreampWarningText" Text="Headroom status" Foreground="#E4C986" TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                </StackPanel>
            </controls:AccentBorder>

            <controls:AccentBorder Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stereo Image Preservation" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Limits correction differences between left and right in the frequency range most important for phantom-center localization. The average tonal correction is preserved." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <CheckBox x:Name="StereoPreservationCheck" Content="Preserve stereo image (recommended)" Style="{StaticResource SwitchStyle}" Checked="StereoSettingChanged" Unchecked="StereoSettingChanged"/>
                    <Grid Width="540" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Max L/R correction difference (150 Hz–5 kHz)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Slider x:Name="StereoDifferenceSlider" Grid.Column="1" Minimum="0.5" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="StereoDifferenceSlider_ValueChanged"/>
                        <TextBlock x:Name="StereoDifferenceText" Grid.Column="2" Text="2.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="AudioTune allows a wider difference in deep bass and upper treble. A separate optional Centering Test can add a small post-EQ channel trim without boosting either channel." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </controls:AccentBorder>

            <controls:AccentBorder Grid.Row="5" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,20" Padding="20">
                <StackPanel>
                    <TextBlock Text="Measurement Safety / Interpretation" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="AudioTune currently measures digital threshold level in dBFS. Without calibrated SPL hardware, it cannot determine dB SPL at the eardrum and must not label results as clinical dB HL. AudioTune fixes only its own app-session volume at 50%; keep the Windows master volume and any external hardware amplifier unchanged for an entire session." TextWrapping="Wrap" Foreground="#C2CEDA" FontSize="12" LineHeight="19" Margin="0,10,0,0" />
                </StackPanel>
            </controls:AccentBorder>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="AudioTune.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Debug" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Live diagnostics and developer log" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Clear" Style="{StaticResource FlatButtonStyle}" Margin="4" Click="Clear_Click"/><Button Content="Export Log" Style="{StaticResource PrimaryButtonStyle}" Margin="4" Click="Export_Click"/></StackPanel></Grid>
        <controls:AccentBorder Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0"><TextBox x:Name="LogText" Margin="14" Background="Transparent" BorderThickness="0" Foreground="#B4C4D5" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></controls:AccentBorder>
    </Grid>
</UserControl>

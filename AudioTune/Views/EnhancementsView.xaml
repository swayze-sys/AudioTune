<UserControl x:Class="AudioTune.Views.EnhancementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <UserControl.Resources>
        <Style x:Key="EffectRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1B2B"/>
            <Setter Property="BorderBrush" Value="#27506E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="96"/>
        </Style>
        <Style x:Key="EffectSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="14,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="#188DF4" Height="6" CornerRadius="3"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F7FBFF" Stroke="#83CCFF" StrokeThickness="1.5">
                                                    <Ellipse.Effect><DropShadowEffect Color="#158DFF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="#486780" Height="6" CornerRadius="3"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,18,22,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sound Enhancements" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="Original FxSound processing, isolated inside AudioTune" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" Height="82" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
                    <Image Source="/Assets/Enhancements/header-wave-v1.png" MaxWidth="700" Height="150"
                           Stretch="Fill" Opacity="0.96" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" AccentColor="#71D4FF" AccentEdge="TopLeft" Padding="18" MinHeight="100">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="12" Background="#123C61" BorderBrush="#2787C6" BorderThickness="1.2" VerticalAlignment="Center">
                                <controls:LineIcon Kind="Processor" Width="28" Height="28" Stroke="#51BFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                <TextBlock Text="FxSound Engine" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EngineStatusText" Text="Checking native engine..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Five original effects for local listening and the selected system output." Foreground="#8FA9C2" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="EnabledCheck" Grid.Column="2" Content="Enabled" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed"/>
                        </Grid>
                    </controls:AccentBorder>

                    <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" AccentColor="#46BEFF" AccentEdge="TopLeft" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Enhancement controls" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Five FxSound controls · original 0–10 scale · passed directly to DfxDsp" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,16" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource EffectRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/Enhancements/clarity-v1.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Clarity" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="High-frequency detail and definition." Foreground="#A2B8CE" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="ClaritySlider" Grid.Column="2" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="EffectSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClarityValue" Grid.Column="3" Foreground="#50BDFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource EffectRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/Enhancements/ambience-v1.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Ambience" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Spatial depth and reverberation." Foreground="#A2B8CE" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="AmbienceSlider" Grid.Column="2" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="EffectSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AmbienceValue" Grid.Column="3" Foreground="#50BDFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource EffectRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/Enhancements/surround-v1.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Surround" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="A wider, more immersive sound field." Foreground="#A2B8CE" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SurroundSlider" Grid.Column="2" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="EffectSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SurroundValue" Grid.Column="3" Foreground="#50BDFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource EffectRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/Enhancements/dynamic-boost-v1.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Dynamic Boost" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Perceived loudness and quieter details." Foreground="#A2B8CE" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="DynamicSlider" Grid.Column="2" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="EffectSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DynamicValue" Grid.Column="3" Foreground="#50BDFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource EffectRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/Enhancements/bass-v1.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Bass" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Low-frequency weight and impact." Foreground="#A2B8CE" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="BassSlider" Grid.Column="2" Style="{StaticResource EffectSliderStyle}" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="EffectSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BassValue" Grid.Column="3" Foreground="#50BDFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                            <Border Height="1" Background="#2B4A63" Margin="0,8,0,14"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset to neutral" Style="{StaticResource FlatButtonStyle}" Padding="18,10" Click="Reset_Click"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Padding="18,10" Margin="10,0,0,0" Click="OpenListeningTest_Click">
                                    <StackPanel Orientation="Horizontal"><controls:LineIcon Kind="PlayCircle" Width="18" Height="18" Stroke="White" Margin="0,0,8,0"/><TextBlock Text="Open A/B Listening Test"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </controls:AccentBorder>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" AccentColor="#50D9BC" AccentEdge="TopRight" Padding="18">
                        <Grid>
                            <!-- A low-contrast sound wave is part of the surface, not a stripe above it. -->
                            <Path Data="M 0,47 C 40,47 50,20 83,29 S 130,69 165,37 S 218,16 252,44 S 303,60 342,22"
                                  Width="342" Height="80" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,0,-16,0" IsHitTestVisible="False" StrokeThickness="2" Opacity="0.32">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0043BFFF" Offset="0"/><GradientStop Color="#4A43BFFF" Offset="0.48"/><GradientStop Color="#0030B4EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <StackPanel>
                            <TextBlock Text="Where it is active" FontSize="17" FontWeight="SemiBold"/>
                            <Border x:Name="SystemHostBorder" Background="#201A0E" BorderBrush="#5D4720" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,14,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SystemHostStatusDot" Width="9" Height="9" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="SystemHostStatusText" Text="System-wide output" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SystemHostDescriptionText" Text="Apply DSP once on Devices to load the native host through Equalizer APO." TextWrapping="Wrap" Foreground="#D8C69B" FontSize="10" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Height="150" Margin="0,13,0,10" IsHitTestVisible="False">
                                <Image Source="/Assets/Enhancements/soundfield-v1.png" Height="132" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="WIDER SOUND. A CLEARER WORLD." Foreground="#80CCF6" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                            </Grid>

                            <Border Background="#0B2438" BorderBrush="#286C9C" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="PlayCircle" Width="27" Height="27" Stroke="#53BDFF" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ListeningStatusText" Text="A/B Listening Test · checking" Foreground="#56BCFF" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Compare original and calibrated playback. Both use the same enhancement." TextWrapping="Wrap" Foreground="#A8BFD1" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#0B2B27" BorderBrush="#227D67" BorderThickness="1" CornerRadius="9" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="Shield" Width="26" Height="26" Stroke="#42DAA1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="No double processing" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Local processing yields to the system-wide host when it is active." TextWrapping="Wrap" Foreground="#AACBBF" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Grid>
                    </controls:AccentBorder>

                    <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" AccentColor="#68A6FF" AccentEdge="BottomRight" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Engine identity" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Original FxSound DfxDsp" Margin="0,12,0,0" FontSize="12"/>
                            <TextBlock Text="Pinned upstream commit d8e7a23d37ed5939" Foreground="#8ABDE4" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="AGPL-3.0 · source in repository" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
                            <TextBlock FontSize="11" Margin="0,8,0,0"><Hyperlink NavigateUri="https://github.com/fxsound2/fxsound-app" RequestNavigate="FxSoundRepository_RequestNavigate" Foreground="#67C9FF" Cursor="Hand">View FxSound on GitHub</Hyperlink></TextBlock>
                        </StackPanel>
                    </controls:AccentBorder>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
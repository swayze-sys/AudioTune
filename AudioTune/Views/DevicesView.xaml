<UserControl x:Class="AudioTune.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <UserControl.Resources>
        <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#78C9FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3B668C"/>
            <Setter Property="Content" Value="Info"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <controls:LineIcon Kind="Info" Width="13" Height="13" Stroke="#78C9FF" StrokeThickness="1.8"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#102235"/>
            <Setter Property="BorderBrush" Value="#31516D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SignalNodeStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1A28"/>
            <Setter Property="BorderBrush" Value="#31516D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="72"/>
        </Style>
        <Style x:Key="SignalNodeIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#123B68"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SignalNodeIconStyle" TargetType="controls:LineIcon">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stroke" Value="#82C9FF"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SignalArrowIconStyle" TargetType="controls:LineIcon">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stroke" Value="{StaticResource CyanBrush}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <StackPanel>
                <TextBlock Text="Devices" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Configure audio routing and the system-wide DSP pipeline." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- DSP target -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DSP Target Device" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource InfoButtonStyle}" Click="DspTargetInfo_Click"/>
                        </StackPanel>
                        <ComboBox x:Name="DspDeviceCombo" Style="{StaticResource DarkComboStyle}" Margin="0,12,0,0" SelectionChanged="DspDeviceCombo_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource StatusChipStyle}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ApoChipDot" Width="9" Height="9" Fill="#6F8298" Margin="0,0,8,0"/><TextBlock x:Name="ApoChipText" Text="Equalizer APO checking" FontSize="11"/></StackPanel></Border>
                            <Border Style="{StaticResource StatusChipStyle}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="PersistentChipDot" Width="9" Height="9" Fill="#6F8298" Margin="0,0,8,0"/><TextBlock x:Name="PersistentChipText" Text="Persistent DSP checking" FontSize="11"/></StackPanel></Border>
                            <Border Style="{StaticResource StatusChipStyle}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="FineTuneChipDot" Width="9" Height="9" Fill="#6F8298" Margin="0,0,8,0"/><TextBlock x:Name="FineTuneChipText" Text="Fine Tune —" FontSize="11"/></StackPanel></Border>
                        </WrapPanel>
                        <StackPanel x:Name="ApoInstallPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="ApoInstallStatusText" Text="" Foreground="{StaticResource CyanBrush}" FontSize="10" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ApoDownloadProgress" Height="5" Minimum="0" Maximum="100" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <Button x:Name="InstallApoButton" Content="Install Equalizer APO..." Style="{StaticResource PrimaryButtonStyle}" Width="210" HorizontalAlignment="Left" Margin="0,8,0,0" Click="InstallApo_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#24384C" Width="1"/>

                    <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoApplyCheck" Content="Auto-apply DSP changes" Style="{StaticResource SwitchStyle}" Checked="AutoApplyCheck_Changed" Unchecked="AutoApplyCheck_Changed"/>
                            <Button Style="{StaticResource InfoButtonStyle}" Click="AutoApplyInfo_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AutoApplyStatusText" Text="Fine Tune changes are written to the active persistent DSP immediately." Foreground="#70869E" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button Content="Refresh status" Style="{StaticResource FlatButtonStyle}" HorizontalAlignment="Left" Padding="11,6" Margin="0,12,0,0" Click="RefreshDsp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Signal chain -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Signal Chain" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource InfoButtonStyle}" Click="SignalChainInfo_Click"/>
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Measurement" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ACTIVE PROFILE" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainProfileValue" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                        <controls:LineIcon Grid.Column="1" Kind="ArrowRight" Style="{StaticResource SignalArrowIconStyle}"/>
                        <Border Grid.Column="2" Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Waveform" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CORRECTION PRESET" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainPresetValue" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                        <controls:LineIcon Grid.Column="3" Kind="ArrowRight" Style="{StaticResource SignalArrowIconStyle}"/>
                        <Border Grid.Column="4" Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Sliders" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FINE TUNE" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainFineTuneValue" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                        <controls:LineIcon Grid.Column="5" Kind="ArrowRight" Style="{StaticResource SignalArrowIconStyle}"/>
                        <Border Grid.Column="6" Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Balance" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="STEREO CENTERING" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainCenterValue" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                        <controls:LineIcon Grid.Column="7" Kind="ArrowRight" Style="{StaticResource SignalArrowIconStyle}"/>
                        <Border Grid.Column="8" Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Processor" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="EQUALIZER APO" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainApoValue" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                        <controls:LineIcon Grid.Column="9" Kind="ArrowRight" Style="{StaticResource SignalArrowIconStyle}"/>
                        <Border Grid.Column="10" Style="{StaticResource SignalNodeStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SignalNodeIconBadgeStyle}"><controls:LineIcon Kind="Speaker" Style="{StaticResource SignalNodeIconStyle}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TARGET DEVICE" Foreground="#70869E" FontSize="9"/><TextBlock x:Name="ChainTargetValue" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions + summary -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DSP Actions" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource InfoButtonStyle}" Click="DspActionsInfo_Click"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <Button x:Name="ApplyDspButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Height="86" Click="ApplyDsp_Click">
                                <StackPanel><controls:LineIcon Kind="Play" Width="21" Height="21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="Apply / Update DSP" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="DisableDspButton" Style="{StaticResource FlatButtonStyle}" Margin="6,0" Height="86" Click="DisableDsp_Click">
                                <StackPanel><controls:LineIcon Kind="Pause" Width="21" Height="21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="Bypass DSP" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="DisablePersistentDspButton" Style="{StaticResource FlatButtonStyle}" Margin="6,0" Height="86" Click="DisablePersistentDsp_Click">
                                <StackPanel><controls:LineIcon Kind="Stop" Width="19" Height="19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="Disable DSP" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="ConfigureApoButton" Style="{StaticResource FlatButtonStyle}" Margin="6,0,0,0" Height="86" Click="ConfigureApo_Click">
                                <StackPanel><controls:LineIcon Kind="ExternalLink" Width="21" Height="21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="Open APO Configurator" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ExportDspButton" Content="Export APO config..." Style="{StaticResource FlatButtonStyle}" Padding="11,6" Click="ExportDsp_Click"/>
                            <TextBlock x:Name="CompactDspStatusText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Current DSP Summary" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource InfoButtonStyle}" Click="DspSummaryInfo_Click"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Preset" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SummaryPresetValue" Grid.Column="1" Text="—"/>
                            <TextBlock Grid.Row="1" Text="Intensity" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SummaryIntensityValue" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,7,0,0"/>
                            <TextBlock Grid.Row="2" Text="Fine Tune" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SummaryFineTuneValue" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,7,0,0"/>
                            <TextBlock Grid.Row="3" Text="Stereo Centering" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SummaryCenterValue" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,7,0,0"/>
                            <TextBlock Grid.Row="4" Text="Preamp" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SummaryPreampValue" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,7,0,0"/>
                            <TextBlock Grid.Row="5" Text="Estimated headroom risk" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SummaryRiskValue" Grid.Row="5" Grid.Column="1" Text="—" Margin="0,7,0,0"/>
                        </Grid>
                        <Separator Background="#26394C" Margin="0,14,0,12"/>
                        <Grid>
                            <TextBlock Text="Correction intensity" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CorrectionStrengthValue" Text="100%" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="CorrectionStrengthSlider" Minimum="0" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="CorrectionStrengthSlider_ValueChanged"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Optional/diagnostic playback list, now functional -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                <Expander x:Name="PlaybackDevicesExpander" IsExpanded="False" Background="Transparent" Foreground="{StaticResource TextBrush}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,4">
                            <controls:LineIcon Kind="Speaker" Width="17" Height="17" Stroke="#AFC4D9" VerticalAlignment="Center"/>
                            <TextBlock Text="Detected Playback Devices" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DetectedDeviceCountText" Text="" Foreground="{StaticResource MutedBrush}" Margin="12,1,0,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource InfoButtonStyle}" Click="PlaybackDevicesInfo_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="18,4,18,16">
                        <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="230">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#26394D" BorderThickness="0,0,0,1" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="WASAPI render endpoint" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                            <Button Grid.Column="1" Content="Use for Test" Style="{StaticResource FlatButtonStyle}" Padding="10,5" Margin="8,0,0,0" Click="UseAsTestOutput_Click"/>
                                            <Button Grid.Column="2" Content="Use for DSP" Style="{StaticResource FlatButtonStyle}" Padding="10,5" Margin="8,0,0,0" Click="UseAsDspTarget_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

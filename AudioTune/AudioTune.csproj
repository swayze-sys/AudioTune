<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AudioTune</AssemblyName>
    <RootNamespace>AudioTune</RootNamespace>
    <ApplicationIcon>Assets\App\AudioTune.ico</ApplicationIcon>
    <Version>0.4.16-alpha</Version>
    <AssemblyVersion>0.4.16.0</AssemblyVersion>
    <FileVersion>0.4.16.0</FileVersion>
    <InformationalVersion>0.4.16-alpha</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Headphones\AmironHome.png" />
    <Resource Include="Assets\App\AudioTune.ico" />
    <Resource Include="Assets\App\AudioTune.png" />
    <None Update="Assets\DesignReferences\*.png" CopyToOutputDirectory="Never" />
    <None Update="Data\Headphones\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\Psychoacoustics\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

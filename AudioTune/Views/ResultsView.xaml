<UserControl x:Class="AudioTune.Views.ResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AudioTune.Controls">
  <UserControl.Resources>
    <Style x:Key="ResultChipStyle" TargetType="Border"><Setter Property="Background" Value="#17283A"/><Setter Property="BorderBrush" Value="#2C465F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton"><Setter Property="Foreground" Value="#AFC1D3"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Shell" Background="#132235" BorderBrush="#2B4259" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="2,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#167FD6"/><Setter TargetName="Shell" Property="BorderBrush" Value="#2AA5FF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#69C5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="MetricStyle" TargetType="Border"><Setter Property="Background" Value="#101D2A"/><Setter Property="BorderBrush" Value="#253B50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,9"/></Style>
    <Style x:Key="StatusRowStyle" TargetType="Border"><Setter Property="Background" Value="#122233"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style x:Key="ResultIconBadgeStyle" TargetType="Border"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#18344C"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </UserControl.Resources>
  <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="DebugColumn" Width="310"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0"><StackPanel>
      <Border Style="{StaticResource CardBorderStyle}"><Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
        <Image Source="/Assets/Headphones/AmironHome.png" Stretch="Uniform" Margin="0,0,18,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Your Hearing Results" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Beyerdynamic Amiron Home" FontSize="15" Foreground="#C8D7E6" Margin="0,3,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Border Style="{StaticResource ResultChipStyle}"><StackPanel Orientation="Horizontal"><controls:LineIcon Kind="Measurement" Width="14" Height="14" Stroke="#72C9FF" Margin="0,0,7,0"/><TextBlock x:Name="MeasurementsMetric" Text="0 / 60 measured" Foreground="#7BC9FF" FontSize="11"/></StackPanel></Border><Border x:Name="ConfidenceBadge" Style="{StaticResource ResultChipStyle}"><StackPanel Orientation="Horizontal"><controls:LineIcon x:Name="ConfidenceIcon" Kind="CheckCircle" Width="14" Height="14" Stroke="#50E0AE" Margin="0,0,7,0"/><TextBlock x:Name="ConfidenceMetric" Text="No measurement" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource ResultChipStyle}"><StackPanel Orientation="Horizontal"><controls:LineIcon Kind="Link" Width="14" Height="14" Stroke="#D8E6F3" Margin="0,0,7,0"/><TextBlock x:Name="PortabilityMetric" Text="Device-bound" FontSize="11"/></StackPanel></Border></StackPanel><TextBlock x:Name="ResultTimestampText" Text="No completed measurement yet" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
        <Grid Grid.Column="2" Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Button x:Name="OpenListeningTestButton" Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" Click="OpenListeningTest_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><controls:LineIcon Kind="Play" Width="15" Height="15" Stroke="White" Margin="0,0,9,0"/><TextBlock Text="Start A/B Listening Test"/></StackPanel></Button><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="OpenFineTuneButton" Style="{StaticResource FlatButtonStyle}" Margin="0,0,4,0" Click="OpenFineTune_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><controls:LineIcon Kind="Sliders" Width="16" Height="16" Stroke="#E5F2FF" Margin="0,0,8,0"/><TextBlock Text="Fine Tune"/></StackPanel></Button><Button x:Name="OpenCenteringButton" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Margin="4,0,0,0" Click="OpenCentering_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><controls:LineIcon Kind="Target" Width="16" Height="16" Stroke="#E5F2FF" Margin="0,0,8,0"/><TextBlock Text="Stereo Centering"/></StackPanel></Button></Grid></Grid>
      </Grid></Border>
      <Border x:Name="ResultSummaryBorder" Background="#10342F" BorderBrush="#1C685B" BorderThickness="1" CornerRadius="10" Margin="0,10,0,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#48D7AE" CornerRadius="15"><controls:LineIcon Kind="Check" Width="17" Height="17" Stroke="White" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="ResultSummaryText" Text="Complete a hearing profile to see your result" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ResultInsightText" Text="AudioTune will explain the measured profile and generated correction here." Foreground="#C5D5D5" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.25*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,5,0">
          <Border Style="{StaticResource CardBorderStyle}" Height="310"><Grid Margin="14,11"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Hearing Thresholds" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Measured sensitivity - lower dBFS values mean greater sensitivity" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><RadioButton x:Name="ThresholdBothRadio" GroupName="ThresholdMode" Content="Both" Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Checked="ThresholdModeChanged"/><RadioButton x:Name="ThresholdLeftRadio" GroupName="ThresholdMode" Content="Left" Style="{StaticResource SegmentRadioStyle}" Checked="ThresholdModeChanged"/><RadioButton x:Name="ThresholdRightRadio" GroupName="ThresholdMode" Content="Right" Style="{StaticResource SegmentRadioStyle}" Checked="ThresholdModeChanged"/></StackPanel><TextBlock x:Name="ThresholdValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" Margin="0,4,2,0"/></StackPanel></Grid><controls:FrequencyChart x:Name="ThresholdChart" Grid.Row="1" MinimumY="-3" MaximumY="-90" YUnit="dBFS"/></Grid></Border>
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Height="390"><Grid Margin="14,11"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="70"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Personal Correction" FontSize="15" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/><TextBlock Text="Left" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/><Ellipse Width="7" Height="7" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/><TextBlock Text="Right" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/><CheckBox x:Name="ShowFineTuneCheck" Content="Include saved Fine Tune" FontSize="9" Foreground="{StaticResource MutedBrush}" Checked="CorrectionModeChanged" Unchecked="CorrectionModeChanged"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><RadioButton x:Name="CorrectionTargetRadio" GroupName="CorrectionMode" Content="Target" Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Checked="CorrectionModeChanged"/><RadioButton x:Name="CorrectionDspRadio" GroupName="CorrectionMode" Content="Applied DSP" Style="{StaticResource SegmentRadioStyle}" Checked="CorrectionModeChanged"/><RadioButton x:Name="CorrectionPreStereoRadio" GroupName="CorrectionMode" Content="Before stereo protection" Style="{StaticResource SegmentRadioStyle}" Checked="CorrectionModeChanged"/></StackPanel><TextBlock x:Name="CorrectionValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" Margin="0,4,2,0"/></StackPanel></Grid>
            <controls:FrequencyChart x:Name="CorrectionChart" Grid.Row="1" MinimumY="-12" MaximumY="12" YUnit="dB" ShowZeroLine="True"/>
            <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource MetricStyle}" Margin="0,0,4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:LineIcon Kind="BarChart" Width="22" Height="22" Stroke="#269DFF" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Target peak" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="TargetPeakMetric" Text="-" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Grid.Column="1" Style="{StaticResource MetricStyle}" Margin="4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:LineIcon Kind="Shield" Width="23" Height="23" Stroke="#48D99E" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Required headroom" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="RequiredHeadroomMetric" Text="-" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Grid.Column="2" Style="{StaticResource MetricStyle}" Margin="4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:LineIcon Kind="Waveform" Width="23" Height="23" Stroke="#269DFF" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Applied preamp" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="AppliedPreampMetric" Text="-" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Grid.Column="3" Style="{StaticResource MetricStyle}" Margin="4,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:LineIcon Kind="Balance" Width="23" Height="23" Stroke="#DDE9F4" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Stereo difference" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="StereoDifferenceMetric" Text="-" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border></Grid>
          </Grid></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5,0,0,0">
          <Border Style="{StaticResource CardBorderStyle}"><StackPanel Margin="14,12"><TextBlock Text="Correction status" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Style="{StaticResource StatusRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource ResultIconBadgeStyle}" Background="#123D38"><controls:LineIcon Kind="Check" Width="16" Height="16" Stroke="#50E0AE" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Profile" FontWeight="SemiBold"/><TextBlock x:Name="ProfileStatusDetail" Text="No measurement" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="ProfileStatusValue" Grid.Column="2" Text="-" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource StatusRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource ResultIconBadgeStyle}"><controls:LineIcon Kind="Sliders" Width="16" Height="16" Stroke="#DCE9F5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Fine Tune" FontWeight="SemiBold"/><TextBlock x:Name="FineTuneStatusDetail" Text="Optional refinement" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="FineTuneStatusValue" Grid.Column="2" Text="-" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource StatusRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource ResultIconBadgeStyle}" Background="#123D38"><controls:LineIcon Kind="Shield" Width="17" Height="17" Stroke="#50E0AE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Stereo protection" FontWeight="SemiBold"/><TextBlock Text="Keeps L/R balance stable" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StereoStatusValue" Grid.Column="2" Text="-" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource StatusRowStyle}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource ResultIconBadgeStyle}"><controls:LineIcon Kind="Link" Width="17" Height="17" Stroke="#DCE9F5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Persistent DSP" FontWeight="SemiBold"/><TextBlock x:Name="PersistentDspStatusDetail" Text="Not checked" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="160"/></StackPanel><TextBlock x:Name="PersistentDspStatusValue" Grid.Column="2" Text="-" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel></Border>
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0"><StackPanel Margin="14,12"><TextBlock Text="What this means" FontSize="15" FontWeight="SemiBold"/><Border Background="#122233" CornerRadius="8" Padding="11" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#15344C" CornerRadius="7" VerticalAlignment="Center"><controls:LineIcon Kind="BarChart" Width="17" Height="17" Stroke="#269DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="MeaningPrimaryText" Text="Complete a hearing profile to generate personal insights." TextWrapping="Wrap"/><TextBlock x:Name="MeaningPrimaryDetail" Text="Raw measurements remain unchanged." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border><Border Background="#122233" CornerRadius="8" Padding="11" Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#15344C" CornerRadius="7" VerticalAlignment="Center"><controls:LineIcon Kind="Waveform" Width="18" Height="18" Stroke="#269DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="MeaningSecondaryText" Text="Correction details will appear here." TextWrapping="Wrap"/><TextBlock x:Name="MeaningSecondaryDetail" Text="AudioTune is not a clinical audiometer." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border></StackPanel></Border>
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0"><StackPanel Margin="14,12"><TextBlock Text="Next step" FontSize="15" FontWeight="SemiBold"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:LineIcon Kind="PlayCircle" Width="22" Height="22" Stroke="#269DFF" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Compare calibrated and original sound at matched loudness." TextWrapping="Wrap" Foreground="#C4D3E1" VerticalAlignment="Center"/><Button x:Name="OpenListeningTestSecondaryButton" Grid.Column="2" Content="Open A/B Test" Style="{StaticResource PrimaryButtonStyle}" Padding="11,6" Margin="8,0,0,0" Click="OpenListeningTest_Click" IsEnabled="False"/></Grid></StackPanel></Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0"><Expander Foreground="{StaticResource TextBrush}" Background="Transparent" Padding="14,8"><Expander.Header><StackPanel Orientation="Horizontal"><controls:LineIcon Kind="ChevronDown" Width="13" Height="13" Stroke="#DCE9F5" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Technical details &amp; per-frequency values" FontWeight="SemiBold"/><TextBlock Text="Detailed correction amounts and calibration notes" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel></Expander.Header><Grid Height="190" Margin="0,10,0,0"><controls:CorrectionBarChart x:Name="CorrectionBars"/></Grid></Expander></Border>
    </StackPanel></ScrollViewer>
    <Border x:Name="DeveloperPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="17,15"><TextBlock Text="Debug &amp; Developer Info" FontFamily="Consolas" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Measurement state" Foreground="#69BFFF" FontWeight="SemiBold" Margin="0,20,0,7"/><TextBlock x:Name="DebugSession" Text="Session: none" FontSize="10"/><TextBlock x:Name="DebugMeasurements" Text="Measurements: 0" FontSize="10" Margin="0,6"/><TextBlock Text="Correction model" Foreground="#69BFFF" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock Text="v6 - ISO-shaped relative baseline" FontSize="10"/><TextBlock Text="Fine Tune: 30 frequencies per ear" FontSize="10" Margin="0,6"/><TextBlock x:Name="DebugPreviewStrength" Text="Strength: -" FontSize="10"/><TextBlock x:Name="DebugStereoState" Text="Stereo protection: -" FontSize="10" Margin="0,6"/><Border Background="#211B0F" BorderBrush="#604A22" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,0"><TextBlock Text="Not a clinical audiogram. Absolute SPL at the eardrum is unknown." Foreground="#D8C18D" TextWrapping="Wrap" FontSize="10"/></Border><Button Content="Refresh Results" Style="{StaticResource FlatButtonStyle}" Margin="0,16,0,0" Click="Refresh_Click"/></StackPanel></ScrollViewer></Border>
  </Grid>
</UserControl>

<UserControl x:Class="AudioTune.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <UserControl.Resources>
        <Style x:Key="DashboardSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="78" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#26394B" BorderBrush="#3A5167" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#B8C5D3" HorizontalAlignment="Left" Margin="2"/>
                            </Border>
                            <TextBlock x:Name="StateText" Grid.Column="1" Text="Off" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BlueBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#48B5FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="StateText" Property="Text" Value="On"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6CC7FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="238"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="244"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Selected headphone and listening validation -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="286"/>
                </Grid.ColumnDefinitions>

                <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" Margin="0,0,12,0">
                    <Grid Margin="20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="164"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0" ClipToBounds="False">
                            <Ellipse Width="230" Height="184" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="1" Panel.ZIndex="0" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#D0189CFF" Offset="0"/>
                                        <GradientStop Color="#7A0E77C4" Offset="0.48"/>
                                        <GradientStop Color="#00101F2C" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <BlurEffect Radius="38"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="158" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.9" Panel.ZIndex="0" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#C72EDBFF" Offset="0"/>
                                        <GradientStop Color="#4D148CFF" Offset="0.58"/>
                                        <GradientStop Color="#00101F2C" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <BlurEffect Radius="24"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- The supplied product cutout is intentionally translucent almost everywhere. -->
                            <Border Width="226" Height="214" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#11202D" Panel.ZIndex="1" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Headphones/AmironHomeOcclusionMask.png"
                                                Viewbox="0.14,0.06,0.70,0.86"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="Uniform"/>
                                </Border.OpacityMask>
                            </Border>
                            <Border Width="226" Height="214" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Panel.ZIndex="2" IsHitTestVisible="False">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Headphones/AmironHomeCutout.png"
                                                Viewbox="0.14,0.06,0.70,0.86"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SELECTED HEADPHONE" Foreground="#7389A1" FontSize="10"/>
                            <TextBlock Text="Beyerdynamic Amiron Home" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#0D5D99" CornerRadius="6" HorizontalAlignment="Left" Padding="9,3" Margin="0,7,0,0">
                                <TextBlock Text="End-to-end calibrated" Foreground="#8EDBFF" FontSize="10"/>
                            </Border>
                            <TextBlock Text="AudioTune measures the complete output, headphone, fit, ear and hearing chain. Separate headphone compensation remains disabled."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="620" Margin="0,9,0,0" FontSize="12" LineHeight="17"/>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <controls:LineIcon Kind="Headphones" Width="18" Height="18" Stroke="#A9CFFF" Margin="0,0,8,0"/>
                                    <StackPanel><TextBlock Text="Open-back" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Design" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <controls:LineIcon Kind="BarChart" Width="18" Height="18" Stroke="#A9CFFF" Margin="0,0,8,0"/>
                                    <StackPanel><TextBlock Text="5 Hz – 40 kHz" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Manufacturer range" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:LineIcon Kind="Waveform" Width="18" Height="18" Stroke="#A9CFFF" Margin="0,0,8,0"/>
                                    <StackPanel><TextBlock Text="250 Ω" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Impedance" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Style="{StaticResource FlatButtonStyle}" Click="ChangeHeadphone_Click" Padding="10,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <controls:LineIcon Kind="Refresh" Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Change Headphone" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Border Background="#0A121B" BorderBrush="#263C50" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Calibration mode" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="End-to-end · device-bound" Foreground="{StaticResource GreenBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="30 Hz – 18 kHz · 30 points per ear" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </controls:AccentBorder>

                <controls:AccentBorder Grid.Column="1" Style="{StaticResource GreenLuminousCardStyle}" AccentColor="#42DAA1" AccentEdge="TopRight">
                    <Grid Margin="18,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Kind="Headphones" Width="20" Height="20" Stroke="#A9CFFF" Margin="0,0,10,0"/>
                            <TextBlock Text="Listening check" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,15,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ListeningStateDot" Width="10" Height="10" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ListeningStateText" Text="Ready" Foreground="{StaticResource GreenBrush}" FontSize="17" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Compare calibrated and unprocessed audio at matched loudness." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" LineHeight="16" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button x:Name="OpenAbButton" Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" Click="OpenAbTest_Click" Padding="12,9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:LineIcon Kind="Play" Width="14" Height="14" Stroke="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Open A/B Test" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </controls:AccentBorder>
            </Grid>

            <!-- Processing chain -->
            <controls:AccentBorder Grid.Row="1" Style="{StaticResource LuminousCardStyle}" Margin="0,12,0,0">
                <Grid Margin="16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="78"/>
                    </Grid.RowDefinitions>

                    <!-- Header: chain title, master switch, and compact review notice share one line. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="292"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#12345A" Margin="0,0,12,0">
                                <controls:LineIcon Kind="Waveform" Width="21" Height="21" Stroke="#71C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Processing Chain" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Control the complete signal path or each stage individually." Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audio Processing" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="AudioProcessingStatusText" Text="Checking…" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AudioProcessingDescriptionText" Text="Master processing state" Visibility="Collapsed"/>
                            </StackPanel>
                            <CheckBox x:Name="AudioProcessingToggle" Grid.Column="1" Style="{StaticResource DashboardSwitchStyle}" VerticalAlignment="Center"
                                      ToolTip="Enable the complete processing chain or switch to level-matched bypass. All stage settings remain saved."
                                      Checked="AudioProcessingToggle_Changed" Unchecked="AudioProcessingToggle_Changed"/>
                        </Grid>

                        <Border Grid.Column="2" Background="#241D10" BorderBrush="#72501B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="10,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <controls:LineIcon Kind="Alert" Width="17" Height="17" Stroke="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CalibrationReviewStatusText" Grid.Column="1" Text="No measurements" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="ReviewResultsButton" Grid.Column="2" Style="{StaticResource FlatButtonStyle}" Click="ReviewResults_Click" Padding="9,4" Margin="8,0,0,0">
                                    <TextBlock Text="Review" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Independently switchable processing stages -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" CornerRadius="9" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="#11385C" VerticalAlignment="Top">
                                    <controls:LineIcon Kind="Measurement" Width="17" Height="17" Stroke="#5CC4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,7,0">
                                    <TextBlock Text="Hearing Profile" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock x:Name="HearingProfileStatusText" Text="Personal correction" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource DashboardLinkButtonStyle}" Click="ViewResults_Click" Margin="0,6,0,0" Content="View results"/>
                                </StackPanel>
                                <CheckBox x:Name="HearingProfileToggle" Grid.Column="2" Style="{StaticResource DashboardSwitchStyle}" VerticalAlignment="Top"
                                          ToolTip="Include or bypass the modeled Hearing Profile correction. Raw measurements remain unchanged."
                                          Checked="HearingProfileToggle_Changed" Unchecked="HearingProfileToggle_Changed"/>
                            </Grid>
                        </controls:AccentBorder>

                        <controls:LineIcon Grid.Column="1" Kind="ArrowRight" Width="18" Height="18" Stroke="#20C9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <controls:AccentBorder Grid.Column="2" Style="{StaticResource PurpleLuminousCardStyle}" AccentColor="#AA8CFF" AccentEdge="TopRight" CornerRadius="9" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="#11385C" VerticalAlignment="Top">
                                    <controls:LineIcon Kind="Sliders" Width="17" Height="17" Stroke="#5CC4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,7,0">
                                    <TextBlock Text="Fine Tune" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock x:Name="FineTuneStatusText" Text="No active preset" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource DashboardLinkButtonStyle}" Click="EditFineTune_Click" Margin="0,6,0,0" Content="Edit"/>
                                </StackPanel>
                                <CheckBox x:Name="FineTuneToggle" Grid.Column="2" Style="{StaticResource DashboardSwitchStyle}" VerticalAlignment="Top"
                                          ToolTip="Include or bypass saved Fine Tune measurements without deleting them."
                                          Checked="FineTuneToggle_Changed" Unchecked="FineTuneToggle_Changed"/>
                            </Grid>
                        </controls:AccentBorder>

                        <controls:LineIcon Grid.Column="3" Kind="ArrowRight" Width="18" Height="18" Stroke="#20C9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <controls:AccentBorder Grid.Column="4" Style="{StaticResource LuminousCardStyle}" CornerRadius="9" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="#11385C" VerticalAlignment="Top">
                                    <controls:LineIcon Kind="Balance" Width="17" Height="17" Stroke="#5CC4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,7,0">
                                    <TextBlock Text="Stereo Centering" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock x:Name="StereoCenteringStatusText" Text="0.00 dB" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource DashboardLinkButtonStyle}" Click="StereoCentering_Click" Margin="0,6,0,0" Content="Adjust"/>
                                </StackPanel>
                                <CheckBox x:Name="StereoCenteringToggle" Grid.Column="2" Style="{StaticResource DashboardSwitchStyle}" VerticalAlignment="Top"
                                          ToolTip="Apply or bypass the saved attenuation-only Stereo Centering trim."
                                          Checked="StereoCenteringToggle_Changed" Unchecked="StereoCenteringToggle_Changed"/>
                            </Grid>
                        </controls:AccentBorder>

                        <controls:LineIcon Grid.Column="5" Kind="ArrowRight" Width="18" Height="18" Stroke="#20C9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <controls:AccentBorder Grid.Column="6" Style="{StaticResource AmberLuminousCardStyle}" AccentColor="#FFC66A" AccentEdge="TopRight" CornerRadius="9" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="#11385C" VerticalAlignment="Top">
                                    <controls:LineIcon Kind="Processor" Width="17" Height="17" Stroke="#5CC4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,7,0">
                                    <TextBlock Text="FxSound Enhancements" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock x:Name="FxSoundStatusText" Text="Neutral" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource DashboardLinkButtonStyle}" Click="EditEnhancements_Click" Margin="0,6,0,0" Content="Edit enhancements"/>
                                </StackPanel>
                                <CheckBox x:Name="FxSoundToggle" Grid.Column="2" Style="{StaticResource DashboardSwitchStyle}" VerticalAlignment="Top"
                                          ToolTip="Enable or bypass the saved FxSound enhancement settings."
                                          Checked="FxSoundToggle_Changed" Unchecked="FxSoundToggle_Changed"/>
                            </Grid>
                        </controls:AccentBorder>
                    </Grid>
                </Grid>
            </controls:AccentBorder>
            <!-- Active correction and activity -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" Margin="0,0,7,0">
                    <Grid Margin="16,11">
                        <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Active Correction" FontWeight="SemiBold" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Left" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Right" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,12,0"/>
                                    <Line X1="0" X2="14" Y1="3" Y2="3" Stroke="#9BB0C5" StrokeThickness="1" StrokeDashArray="3,2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FineTuneLegendText" Text="Fine Tune (off)" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="CorrectionMetaText" Text="No active correction" Foreground="#9DB4CB" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <controls:FrequencyChart x:Name="PreviewChart" MinimumY="-12" MaximumY="12" YUnit="dB" ShowZeroLine="True"/>
                            <TextBlock x:Name="PreviewEmptyState" Text="Complete or select a hearing profile to show its correction preview." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewValueText" Text="Hover or click a point" Foreground="#6F8298" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
                        </Grid>
                    </Grid>
                </controls:AccentBorder>

                <controls:AccentBorder Grid.Column="1" Style="{StaticResource LuminousCardStyle}" Margin="5,0,0,0">
                    <StackPanel Margin="16,11">
                        <Grid>
                            <TextBlock Text="Recent Activity" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Live" Foreground="{StaticResource CyanBrush}" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="RecentActivity" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:AccentBorder>
            </Grid>

            <!-- Debug remains optional and compact -->
            <Expander x:Name="DebugExpander" Grid.Row="3" Margin="0,12,0,4" IsExpanded="False" Foreground="{StaticResource TextBrush}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Kind="Terminal" Width="16" Height="16" Stroke="#AFC0D2" Margin="0,0,9,0"/>
                        <TextBlock Text="Debug &amp; System Status" FontWeight="SemiBold" FontSize="11"/>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Audio engine running" Foreground="{StaticResource GreenBrush}" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <controls:AccentBorder Style="{StaticResource LuminousCardStyle}" Margin="0,8,0,0" MinHeight="130">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DebugTextBox" Background="Transparent" BorderThickness="0" Foreground="#AFC0D2" FontFamily="Consolas" FontSize="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Audio Engine" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Sample Rate" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="1" Text="48,000 Hz" FontSize="11"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Test format" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="1" Text="32-bit float / stereo" FontSize="11"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Output" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="1" Text="WASAPI shared" FontSize="11"/></Grid>

<UserControl x:Class="AudioTune.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioTune.Controls">
    <UserControl.Resources>
        <Style x:Key="ProfileQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="QuickActionIconStyle" TargetType="controls:LineIcon">
            <Setter Property="Stroke" Value="#86C8FF"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QuickActionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ProfileStatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ProfileStatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page title -->
            <StackPanel>
                <TextBlock Text="Profiles" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Manage hearing measurements and correction presets." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Compact profile summary -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.62*"/>
                        <ColumnDefinition Width="0.78*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/Headphones/AmironHome.png" Stretch="Uniform" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CURRENT HEADPHONE" Foreground="#70869E" FontSize="10"/>
                            <TextBlock Text="Beyerdynamic Amiron Home" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="Profiles are specific to this measured headphone + output chain." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0" Padding="24,0" Margin="0,3">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PROFILE TYPE" Foreground="#70869E" FontSize="10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#123B68" VerticalAlignment="Center">
                                    <controls:LineIcon Kind="Link" Width="18" Height="18" Stroke="#74B8FF" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Device-bound" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Measured output path + headphones + fit + ears" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="210"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE PROFILE" Foreground="#70869E" FontSize="10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,5,9,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock x:Name="ActiveProfileName" Text="None" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ActiveProfileDetails" Text="Select or create a profile." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main profile workspace -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.82*"/>
                    <ColumnDefinition Width="1.38*"/>
                </Grid.ColumnDefinitions>

                <!-- Saved hearing profiles -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" MinHeight="600" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Saved Hearing Profiles" FontSize="18" FontWeight="SemiBold"/>
                                <Border Background="#143A68" CornerRadius="10" Padding="8,2" Margin="10,1,0,0">
                                    <TextBlock x:Name="ProfileCountText" Text="0" Foreground="#BFE2FF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileSearchBox" Height="38" Padding="10,7" Background="#0A121B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" TextChanged="ProfileSearchBox_TextChanged" ToolTip="Search profiles by name or measured device"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Padding="12,8" Click="Import_Click"><StackPanel Orientation="Horizontal"><controls:LineIcon Kind="Import" Width="15" Height="15" Stroke="#86C8FF" Margin="0,0,7,0"/><TextBlock Text="Import..."/></StackPanel></Button>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="14,8" Click="NewTest_Click"><StackPanel Orientation="Horizontal"><controls:LineIcon Kind="Plus" Width="15" Height="15" Stroke="White" Margin="0,0,7,0"/><TextBlock Text="New hearing test"/></StackPanel></Button>
                        </Grid>

                        <ListBox x:Name="ProfileList" Grid.Row="2" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#0A121B" BorderBrush="#223A50" BorderThickness="1" CornerRadius="9" Padding="12">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#101E2D"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/><Setter TargetName="ItemBorder" Property="Background" Value="#0E1C2B"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#7BBFFF" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ActiveLabel}" Foreground="{StaticResource GreenBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ArchiveLabel}" Foreground="{StaticResource AmberBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Expander Grid.Row="3" Header="More profile actions" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="SaveCopyButton" Content="Save protected copy" Style="{StaticResource FlatButtonStyle}" Margin="0,0,4,0" Click="SaveCopy_Click"/>
                                <Button x:Name="CompareButton" Grid.Column="1" Content="Compare with active" Style="{StaticResource FlatButtonStyle}" Margin="4,0,0,0" Click="Compare_Click"/>
                            </Grid>
                        </Expander>
                    </Grid>
                </Border>

                <!-- Selected profile details -->
                <Grid Grid.Column="1" Margin="7,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Selected Hearing Profile" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Width="54" Height="54" Background="#123B68" CornerRadius="27" Margin="0,0,12,0">
                                        <controls:LineIcon Kind="Measurement" Width="25" Height="25" Stroke="#85C4FF" StrokeThickness="1.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" MinWidth="0">
                                        <TextBlock x:Name="SelectedProfileName" Text="No saved profile" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SelectedProfileDetails" Text="Select a hearing profile on the left." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SelectedProfileDevice" Text="—" Foreground="#7BBFFF" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="18,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid HorizontalAlignment="Right">
                                    <Border x:Name="ActiveProfileBadge" Visibility="Collapsed" Background="#0D3B2D" BorderBrush="#1B8D67" BorderThickness="1" CornerRadius="12" Padding="11,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#28E58B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Active Profile" Foreground="#28E58B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="SetActiveButton" Content="Set as active profile" Style="{StaticResource FlatButtonStyle}" HorizontalAlignment="Right" Padding="12,6" Click="SetActive_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Profile type" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="SelectedProfileType" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" HorizontalAlignment="Right"/></Grid>
                                <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Created" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="SelectedProfileCreated" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" HorizontalAlignment="Right"/></Grid>
                                <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Last saved" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="SelectedProfileSaved" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" HorizontalAlignment="Right"/></Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Correction Presets" FontSize="18" FontWeight="SemiBold"/>
                                <controls:LineIcon Kind="Info" Width="15" Height="15" Stroke="#74B8FF" Margin="154,1,0,0" HorizontalAlignment="Left" ToolTip="Correction presets keep tuning separate from the raw hearing measurement."/>
                            </Grid>
                            <ComboBox x:Name="PresetCombo" Style="{StaticResource DarkComboStyle}" Margin="0,12,0,0" SelectionChanged="PresetCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="280">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="7" Background="#123B68" VerticalAlignment="Center">
                                                <controls:LineIcon Kind="Waveform" Width="16" Height="16" Stroke="#75C4FF" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Correction preset" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="PresetAvailabilityText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="BarChart" Width="19" Height="19" Stroke="#78C9FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Intensity" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="PresetIntensityValue" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <Grid Grid.Column="1" Margin="12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="Sliders" Width="19" Height="19" Stroke="#78C9FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Fine Tune" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="PresetFineTuneValue" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <Grid Grid.Column="2" Margin="12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="Balance" Width="19" Height="19" Stroke="#78C9FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Stereo Centering" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="PresetCenterValue" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <Grid Grid.Column="3" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:LineIcon Kind="Processor" Width="19" Height="19" Stroke="#78C9FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Algorithm" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="PresetAlgorithmValue" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold"/>
                                <UniformGrid Columns="3" Rows="3" Margin="-4,9,-4,-4">
                                    <Button x:Name="RenameButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Rename_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Edit" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Rename" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="EditButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Edit_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Refresh" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Retest frequencies" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="FineTuneButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="FineTune_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Sliders" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Optional Fine Tuning" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="CenteringButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Centering_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Balance" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Stereo Centering" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="DuplicatePresetButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="DuplicatePreset_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Copy" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Duplicate preset" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="ListeningButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Listening_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Compare" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Open A/B Listening Test" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="ExportButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Export_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Export" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Export JSON..." Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="ArchiveButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Archive_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Archive" Style="{StaticResource QuickActionIconStyle}"/><TextBlock x:Name="ArchiveButtonLabel" Grid.Column="1" Text="Archive profile" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                    <Button x:Name="RestoreButton" Style="{StaticResource ProfileQuickButtonStyle}" Click="Restore_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Restore" Style="{StaticResource QuickActionIconStyle}"/><TextBlock Grid.Column="1" Text="Restore backup" Style="{StaticResource QuickActionTextStyle}"/></Grid></Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Measurement Summary" FontSize="18" FontWeight="SemiBold"/>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Measurements" Style="{StaticResource ProfileStatLabelStyle}"/><TextBlock x:Name="SummaryMeasurements" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}"/>
                                    <TextBlock Grid.Row="1" Text="Points not detected" Style="{StaticResource ProfileStatLabelStyle}" Margin="0,8,0,0"/><TextBlock x:Name="SummaryCeiling" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Sample rate" Style="{StaticResource ProfileStatLabelStyle}" Margin="0,8,0,0"/><TextBlock x:Name="SummarySampleRate" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Text="Protocol version" Style="{StaticResource ProfileStatLabelStyle}" Margin="0,8,0,0"/><TextBlock x:Name="SummaryProtocol" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="4" Text="Correction model" Style="{StaticResource ProfileStatLabelStyle}" Margin="0,8,0,0"/><TextBlock x:Name="SummaryAlgorithm" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="5" Text="Audio API" Style="{StaticResource ProfileStatLabelStyle}" Margin="0,8,0,0"/><TextBlock x:Name="SummaryAudioApi" Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource ProfileStatValueStyle}" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
